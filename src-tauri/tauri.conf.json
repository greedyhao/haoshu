{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "haoshu",
  "version": "0.1.0",
  "identifier": "com.haoshu.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "东方术数",
        "width": 1120,
        "height": 820,
        "minWidth": 920,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "./resources/corpus.db",
      "./resources/shensha.db",
      "./resources/cross_pillar_matrix.json",
      "./resources/prompts/prompt_friendly.md",
      "./resources/prompts/prompt_interactive.md",
      "./resources/prompts/prompt_round2.md"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
